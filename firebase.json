{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/join/:code",
        "destination": "/?code=:code",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/s/**",
        "function": "viewEvent"
      },
      {
        "source": "/privacyPolicy",
        "function": "privacyPolicy"
      },
      {
        "source": "/termsOfService",
        "function": "termsOfService"
      },
      {
        "source": "/support",
        "function": "support"
      },
      {
        "source": "/dataSafety",
        "function": "dataSafety"
      },
      {
        "source": "/about",
        "function": "about"
      },
      {
        "source": "/deleteAccount",
        "function": "deleteAccount"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
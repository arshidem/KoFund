rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // 🛡️ HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return getUserData().role == 'admin' || getUserData().isAdmin == true;
    }
    
    function isDeveloper() {
      return getUserData().isDeveloper == true;
    }
    
    function isMemberOf(communityId) {
      return getUserData().communityId == communityId;
    }

    // Helper: is this a virtual-to-real user merge update?
    function isVirtualUserMerge() {
      return resource.data.userId.matches('virtual_.*') && 
             request.resource.data.userId == request.auth.uid;
    }

    // 👤 USERS
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId || isAdmin() || isDeveloper();
      // Allow community members to delete virtual users (merge approval flow)
      allow delete: if isSignedIn() && resource.data.isVirtualUser == true;
      
      // 🔔 User Notifications
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == userId;
      }
      
      // 📢 Read Announcements
      match /read_announcements/{announcementId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // 🏘️ COMMUNITIES
    match /communities/{communityId} {
      allow read: if isSignedIn();
      // Anyone signed in can create a community
      allow create: if isSignedIn();
      // Allow updates if user is admin, creator, or if member is updating only membership count/activity
      allow update: if isSignedIn() && (
        (isAdmin() && isMemberOf(communityId)) ||
        (request.auth.uid == resource.data.createdBy) ||
        (isMemberOf(communityId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalMembers', 'lastActivityAt']))
      );
      // Only admins or community creator can delete
      allow delete: if isSignedIn() && (
        (isAdmin() && isMemberOf(communityId)) ||
        (request.auth.uid == resource.data.createdBy)
      );
      
      // 👥 Community Members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn();
        // Allow any signed-in user to create a member document (e.g., admin on community creation)
        allow create: if isSignedIn();
        // Admins, community creator, and users can update/delete member docs
        allow update, delete: if isSignedIn() && (
          request.auth.uid == memberId ||
          (isAdmin() && isMemberOf(communityId)) ||
          (request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)).data.createdBy)
        );
      }

      // 🧑‍💻 Virtual Users subcollection
      match /virtualUsers/{virtualUserId} {
        allow read: if isSignedIn();
        // Only admins can create/update virtual user entries
        allow create, update: if isSignedIn() && isAdmin() && isMemberOf(communityId);
        // Allow community members to delete (merge approval flow)
        allow delete: if isSignedIn();
      }
      

    }

    // 📱 APP CONFIG
    match /app_config/{docId} {
      // Allow signed‑in users to read configuration (e.g., version checks)
      allow read: if isSignedIn();
    }
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }

    // 📅 EVENTS
    match /events/{eventId} {
      // Allow read if:
      // 1. resource is null (list/query — communityId filter is enforced by the query itself)
      // 2. resource exists and the user is a member of that community
      // 3. the event is public
      // 4. the user is a developer (for analytics)
      allow read: if isSignedIn() && (
        resource == null ||
        isMemberOf(resource.data.communityId) || 
        resource.data.isPublicEnabled == true ||
        isDeveloper()
      );
      
      allow write: if isSignedIn() && (
        isAdmin() && (
          (request.resource != null && isMemberOf(request.resource.data.communityId)) || 
          (resource != null && isMemberOf(resource.data.communityId))
        )
      );
    }

    // 🤝 PARTICIPANTS
    match /participants/{participantId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isMemberOf(resource.data.communityId) ||
        isDeveloper()
      );
      
      allow write: if isSignedIn() && (
        (request.resource != null && isMemberOf(request.resource.data.communityId)) || 
        (resource != null && isMemberOf(resource.data.communityId))
      );
      // Allow community members to update during virtual user merge
      allow update: if isSignedIn() && resource.data.userId.matches('virtual_.*') && request.resource.data.userId == request.auth.uid;
    }

    // 💰 CONTRIBUTIONS
    match /contributions/{contributionId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isMemberOf(resource.data.communityId) ||
        isDeveloper()
      );
      allow write: if isSignedIn() && (
        isAdmin() && (
          (request.resource != null && isMemberOf(request.resource.data.communityId)) || 
          (resource != null && isMemberOf(resource.data.communityId))
        )
      );
      // Allow community members to update during virtual user merge
      allow update: if isSignedIn() && isVirtualUserMerge();
    }
  
    // 🗑️ DELETED CONTRIBUTIONS
    match /deleted_contributions/{contributionId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isMemberOf(resource.data.communityId) ||
        isDeveloper()
      );
      allow write: if isSignedIn() && (
        isAdmin() && (
          (request.resource != null && isMemberOf(request.resource.data.communityId)) || 
          (resource != null && isMemberOf(resource.data.communityId))
        )
      );
      // Allow community members to update during virtual user merge
      allow update: if isSignedIn() && isVirtualUserMerge();
    }

    // 💸 EXPENSES
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isMemberOf(resource.data.communityId) ||
        isDeveloper()
      );
      allow write: if isSignedIn() && (
        isAdmin() && (
          (request.resource != null && isMemberOf(request.resource.data.communityId)) || 
          (resource != null && isMemberOf(resource.data.communityId))
        )
      );
      // Allow community members to update during virtual user merge (paidBy field)
      allow update: if isSignedIn() && 
        resource.data.paidBy.matches('virtual_.*') && 
        request.resource.data.paidBy == request.auth.uid;
    }

    // 📊 POLLS
    match /polls/{pollId} {
      allow read: if isSignedIn() && (
        resource == null ||
        isDeveloper()
      );
      allow write: if isSignedIn() && isAdmin();
    }

    // 🔔 NOTIFICATIONS (top-level, for analytics)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isDeveloper();
    }

    // 📱 FCM TOKENS
    match /user_notification_tokens/{token} {
      allow read, write: if isSignedIn();
    }

    // 🐛 ISSUES
    match /issues/{issueId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.reporterId == request.auth.uid || 
        isAdmin() ||
        isDeveloper()
      );
      allow update: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid || 
        isAdmin() ||
        isDeveloper()
      );
      allow delete: if isSignedIn() && (isAdmin() || isDeveloper());
    }

    // ⏳ RATE LIMITS (System Only)
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }
    
    // 🛑 DENY ALL BY DEFAULT
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

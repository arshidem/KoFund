rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // 🛡️ HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return getUserData().role == 'admin';
    }
    
    function isMemberOf(communityId) {
      return getUserData().communityId == communityId;
    }

    // 👤 USERS
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId || isAdmin();
      
      // 🔔 User Notifications
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      
      // 📢 Read Announcements
      match /read_announcements/{announcementId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // 🏘️ COMMUNITIES
    match /communities/{communityId} {
      // Anyone signed in can create a community
      allow create: if isSignedIn();
      // Only admins (who are members) can update or delete
      allow update, delete: if isSignedIn() && isAdmin() && isMemberOf(communityId);
      // 👥 Community Members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn();
        // Allow any signed-in user to create a member document (e.g., admin on community creation)
        allow create: if isSignedIn();
        // Only admins can update or delete existing member docs
        allow update, delete: if isSignedIn() && isAdmin() && isMemberOf(communityId);
      }

      // 🧑‍💻 Virtual Users subcollection
      match /virtualUsers/{virtualUserId} {
        allow read: if isSignedIn();
        // Only admins can create, update, delete virtual user entries
        allow create, update, delete: if isSignedIn() && isAdmin() && isMemberOf(communityId);
      }
      

    }

    // 📱 APP CONFIG
    match /app_config/{docId} {
      // Allow signed‑in users to read configuration (e.g., version checks)
      allow read: if isSignedIn();
    }
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdmin();
    }

    // 📅 EVENTS
    match /events/{eventId} {
      allow read: if isSignedIn() && (
        isMemberOf(resource.data.communityId) || 
        resource.data.isPublicEnabled == true
      );
      
      allow write: if isSignedIn() && (
        isAdmin() && (
          (request.resource != null && isMemberOf(request.resource.data.communityId)) || 
          (resource != null && isMemberOf(resource.data.communityId))
        )
      );
    }

    // 🤝 PARTICIPANTS
    match /participants/{participantId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid == resource.data.userId || 
        (isMemberOf(resource.data.communityId) && (
          isAdmin() || 
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.showDetailedProfile == true
        ))
      );
      
      allow write: if isSignedIn() && (
        (request.resource != null && isMemberOf(request.resource.data.communityId)) || 
        (resource != null && isMemberOf(resource.data.communityId))
      );
    }

    // 💰 CONTRIBUTIONS
    match /contributions/{contributionId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid == resource.data.userId || 
        (isMemberOf(resource.data.communityId) && (
          isAdmin() || 
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.showDetailedProfile == true
        ))
      );
      allow write: if isSignedIn() && (
        isAdmin() && (
          (request.resource != null && isMemberOf(request.resource.data.communityId)) || 
          (resource != null && isMemberOf(resource.data.communityId))
        )
      );
    }
  
    // 🗑️ DELETED CONTRIBUTIONS
    match /deleted_contributions/{contributionId} {
      allow read: if isSignedIn() && isMemberOf(resource.data.communityId);
      allow write: if isSignedIn() && (
        isAdmin() && (
          (request.resource != null && isMemberOf(request.resource.data.communityId)) || 
          (resource != null && isMemberOf(resource.data.communityId))
        )
      );
    }

    // 💸 EXPENSES
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && isMemberOf(resource.data.communityId);
      allow write: if isSignedIn() && (
        isAdmin() && (
          (request.resource != null && isMemberOf(request.resource.data.communityId)) || 
          (resource != null && isMemberOf(resource.data.communityId))
        )
      );
    }

    // 📱 FCM TOKENS
    match /user_notification_tokens/{token} {
      allow read, write: if isSignedIn();
    }

    // ⏳ RATE LIMITS (System Only)
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }
    
    // 🛑 DENY ALL BY DEFAULT
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Community logos ──────────────────────────────────────────────
    // Only the community admin can write; any authenticated member can read.
    match /communities/{communityId}/logo.jpg {

      // READ: any signed-in user can load the logo
      allow read: if request.auth != null;

      // WRITE: must be authenticated AND file ≤ 2 MB AND be an image
      allow write: if request.auth != null
                   && request.resource.size <= 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── User profile pictures (if used elsewhere) ────────────────────
    match /users/{userId}/profile.jpg {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Default: deny everything else ───────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
